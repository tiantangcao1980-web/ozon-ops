# 复制为 .secrets/ozon.env 后填真实值（Windows: mkdir .secrets; copy ozon.env.example .secrets\ozon.env）
# 可在 Ozon 卖家后台 设置 -> Seller API 查看 Client-Id 并生成 Api-Key
OZON_CLIENT_ID=
OZON_API_KEY=
# 1 = 账号已订阅 Premium Pro（会尝试市场级分析接口）；0 = 未订阅（跳过并在报告里标 no_access）
OZON_PREMIUM_PRO=0
# 广告 API（Performance）：后台 API ключи -> Performance API 页签建服务账号后填
# client_id 形如 xxx@advertising.performance.ozon.ru
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=
